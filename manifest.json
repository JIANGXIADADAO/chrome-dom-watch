{
  "manifest_version": 3,
  "name": "DOM Watch — Page Change Monitor",
  "version": "1.0.0",
  "description": "Watch any page element for changes. Logs to Google Sheets, fires browser notifications. Built with MutationObserver + Apps Script webhook.",
  "permissions": ["storage", "notifications", "activeTab", "scripting"],
  "host_permissions": ["https://script.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DOM Watch"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
